# Generated by scripts/update-tap.sh in hassansys2/remote-desktop-toggle. Do not edit by hand.
cask "remote-desktop-toggle" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/hassansys2/remote-desktop-toggle/releases/download/v#{version}/RemoteDesktopToggle-#{version}.pkg"
  name "Remote Desktop Toggle"
  desc "Menu-bar switch to turn Chrome Remote Desktop access on and off"
  homepage "https://github.com/hassansys2/remote-desktop-toggle"

  livecheck do
    url :url
    strategy :github_latest
  end

  # The app updates itself with Sparkle.
  auto_updates true
  depends_on macos: :ventura

  pkg "RemoteDesktopToggle-#{version}.pkg"

  uninstall quit:    "io.github.hassansys2.remote-desktop-toggle",
            script:  {
              executable:   "/Library/PrivilegedHelperTools/remote-desktop-toggle/uninstall.sh",
              sudo:         true,
              must_succeed: false,
            },
            pkgutil: "io.github.hassansys2.remote-desktop-toggle",
            delete:  [
              "/Applications/Remote Desktop Toggle.app",
              "/etc/sudoers.d/remote-desktop-toggle",
              "/Library/PrivilegedHelperTools/remote-desktop-toggle",
            ]

  zap trash: [
    "~/Library/Caches/io.github.hassansys2.remote-desktop-toggle",
    "~/Library/HTTPStorages/io.github.hassansys2.remote-desktop-toggle",
    "~/Library/Preferences/io.github.hassansys2.remote-desktop-toggle.plist",
  ]

  caveats <<~EOS
    Remote Desktop Toggle needs Chrome Remote Desktop to be installed and set up first:
      https://remotedesktop.google.com/access
  EOS
end
